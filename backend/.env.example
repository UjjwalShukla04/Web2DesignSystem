# Copy to .env and fill in what you need. Only one AI key is required.

# --- AI providers ---
# Google Gemini (the default provider). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI, used when "OpenAI" is chosen in the app's settings. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model overrides.
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-4o

# --- Access control (required in production) ---
# API_SECRET=choose-a-long-random-password
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- AI usage limits for the server's keys (users with their own key aren't limited) ---
# DAILY_GENERATIONS_PER_USER=50   # per user (IP) per day; 0 = unlimited
# DAILY_BUDGET_USD=5              # estimated USD per day, all users; 0 = off
# Prices in USD per 1M tokens, used for cost estimates:
# GEMINI_PRICE_INPUT=0.3
# GEMINI_PRICE_OUTPUT=2.5
# OPENAI_PRICE_INPUT=2.5
# OPENAI_PRICE_OUTPUT=10

# --- Optional ---
# PORT=4000
# TRUST_PROXY=1
# MAX_CONCURRENT_SCRAPES=1
# SCRAPE_TIMEOUT_MS=90000
# SCRAPE_CACHE_TTL_MS=600000
# SCRAPE_CACHE_MAX_ENTRIES=10
# LOG_FILE=server.log
